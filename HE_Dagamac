
#include <stdio.h>

int main() {
    int choice;
    float balance = 500.00, amount;

    do {
        printf("\nBSIT BANK\n");
        printf("Please Select your Transaction\n");
        printf("[1] Balance Inquiry\n");
        printf("[2] Deposit\n");
        printf("[3] Withdraw\n");
        printf("[4] Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        if (choice == 1) {
            printf("\nYour current balance: P%.2f\n", balance);
        }
        else if (choice == 2) {
            printf("\nEnter amount to deposit: ");
            scanf("%f", &amount);

            if (amount >= 100.00) {
                balance = balance + amount;
                printf("Deposited successfuly!\n");
                printf("Your new balance: P%.2f\n", balance);
            }
            else {
                printf("Minimum deposit is P100.00.\n");
            }
        }
        else if (choice == 3) {
            printf("\nEnter amount to withdraw: ");
            scanf("%f", &amount);

            if (amount <= 0) {
                printf("Invalid amount!\n");
            }
            else if (balance - amount >= 500.00) {
                balance = balance - amount;
                printf("Withdrawal successfuly!\n");
                printf("Your new balance: P%.2f\n", balance);
            }
            else {
                printf("Withdrawal denied!\n");
                printf("You must maintain at least P100.00 in your account.\n");
            }
        }
        else if (choice == 4) {
            printf("\nThank you for using BSIT BANK!\n");
        }
        else {
            printf("\nInvalid choice! Please try again.\n");
        }

    } while (choice != 4);

    return 0;
}
